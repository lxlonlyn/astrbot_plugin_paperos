{
  "general": {
    "type": "object",
    "description": "通用配置",
    "items": {
      "default_provider_id": {
        "type": "string",
        "description": "通用模型 Provider",
        "hint": "用于普通摘要、整理、问答。留空则使用当前会话默认 Provider。",
        "default": "",
        "_special": "select_provider"
      },
      "thinking_provider_id": {
        "type": "string",
        "description": "思考模型 Provider",
        "hint": "用于论文理解、方法分析、规划等较重任务。留空则回退到通用模型 Provider。",
        "default": "",
        "_special": "select_provider"
      },
      "debug": {
        "type": "bool",
        "description": "启用调试日志",
        "default": false
      }
    }
  },
  "core_api": {
    "type": "object",
    "description": "CORE API 配置",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用 CORE 搜索",
        "default": true
      },
      "api_key": {
        "type": "string",
        "description": "CORE API Key",
        "hint": "建议填写。没有 key 时只能做非常有限的公开元数据查询。",
        "default": "",
        "obscure": true
      },
      "base_url": {
        "type": "string",
        "description": "CORE API Base URL",
        "default": "https://api.core.ac.uk/v3"
      },
      "timeout_seconds": {
        "type": "int",
        "description": "请求超时时间，秒",
        "default": 25
      },
      "default_limit": {
        "type": "int",
        "description": "默认候选数量",
        "default": 10
      },
      "topic_candidate_limit": {
        "type": "int",
        "description": "话题发现候选数量",
        "default": 20
      },
      "sort": {
        "type": "string",
        "description": "CORE 排序方式",
        "default": "relevance",
        "options": ["relevance", "recency"]
      }
    }
  },
  "search_policy": {
    "type": "object",
    "description": "论文搜索策略",
    "items": {
      "accept_min_score": {
        "type": "float",
        "description": "自动接受 top1 的最低分数",
        "default": 0.78
      },
      "ambiguous_gap_threshold": {
        "type": "float",
        "description": "top1 与 top2 分差低于该值时认为有歧义",
        "default": 0.08
      },
      "max_return_candidates": {
        "type": "int",
        "description": "有歧义时最多返回候选数量",
        "default": 5
      },
      "enable_query_rewrite": {
        "type": "bool",
        "description": "启用简单查询改写",
        "hint": "当前版本只做规则改写；后续可以接入通用/思考模型。",
        "default": true
      }
    }
  }
}
