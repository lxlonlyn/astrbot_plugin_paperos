{
  "general": {
    "type": "object",
    "description": "通用配置",
    "items": {
      "default_provider_id": {
        "type": "string",
        "description": "通用模型 Provider",
        "hint": "用于 QueryAnalyzer 等轻量 LLM 调用。留空则使用当前会话默认 Provider。",
        "default": "",
        "_special": "select_provider"
      },
      "thinking_provider_id": {
        "type": "string",
        "description": "思考模型 Provider",
        "hint": "用于论文理解、方法分析、规划等较重任务。留空则回退到通用 Provider。",
        "default": "",
        "_special": "select_provider"
      },
      "debug": {
        "type": "bool",
        "description": "启用调试日志",
        "default": false
      }
    }
  },
  "query_analyzer": {
    "type": "object",
    "description": "自然语言检索解析。该阶段只调用 AstrBot LLM，不调用网页搜索后端。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用 LLM QueryAnalyzer",
        "default": true
      },
      "provider_id": {
        "type": "string",
        "description": "QueryAnalyzer 使用的模型 Provider",
        "hint": "留空则使用 general.default_provider_id；仍为空则使用当前会话 Provider。",
        "default": "",
        "_special": "select_provider"
      },
      "max_repair_rounds": {
        "type": "int",
        "description": "crawler 查不到候选时，允许 LLM 修复 SearchPlan 的轮数",
        "default": 1
      },
      "max_hypotheses": {
        "type": "int",
        "description": "LLM 最多生成多少个检索假设",
        "default": 6
      },
      "max_web_search_queries": {
        "type": "int",
        "description": "启用 AstrBot 网页搜索时，QueryAnalyzer 最多主动发起多少次搜索。为避免模型循环调用，硬上限为 5；设为 0 可禁用该阶段。",
        "default": 5
      }
    }
  },
  "crawler": {
    "type": "object",
    "description": "爬虫配置",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用 targeted crawler",
        "default": true
      },
      "timeout_seconds": {
        "type": "int",
        "description": "候选页面请求超时时间，秒",
        "default": 25
      },
      "max_known_urls": {
        "type": "int",
        "description": "一次 SearchPlan 最多跟进多少个明确来源 URL/identifier",
        "default": 12
      },
      "max_site_lookup_results": {
        "type": "int",
        "description": "按精确标题在已知站点（arXiv/ACM）最多取回多少个候选",
        "default": 5
      },
      "max_html_bytes": {
        "type": "int",
        "description": "单个 HTML 页面最大读取字节数",
        "default": 2097152
      },
      "max_pdf_links_per_page": {
        "type": "int",
        "description": "单个页面最多抽取多少个 PDF 链接",
        "default": 8
      },
      "user_agent": {
        "type": "string",
        "description": "HTTP User-Agent",
        "default": "Mozilla/5.0 (compatible; PaperOS/0.2; +https://github.com/lxlonlyn/astrbot_plugin_paperos)"
      }
    }
  },
  "core_api": {
    "type": "object",
    "description": "已弃用，Legacy CORE API 配置。仅保留兼容。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用旧 CORE provider fallback（当前主链路不使用）",
        "default": false
      },
      "api_key": {
        "type": "string",
        "description": "CORE API Key",
        "default": "",
        "obscure": true
      },
      "base_url": {
        "type": "string",
        "description": "CORE API Base URL",
        "default": "https://api.core.ac.uk/v3"
      },
      "timeout_seconds": {
        "type": "int",
        "description": "请求超时时间，秒",
        "default": 25
      },
      "default_limit": {
        "type": "int",
        "description": "默认候选数量",
        "default": 10
      },
      "topic_candidate_limit": {
        "type": "int",
        "description": "话题发现候选数量",
        "default": 20
      },
      "sort": {
        "type": "string",
        "description": "CORE 排序方式",
        "default": "relevance",
        "options": ["relevance", "recency"]
      }
    }
  },
  "storage": {
    "type": "object",
    "description": "本地持久化存储配置。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用 storage 本地持久化能力。启用后 search 主流程可将已选候选和已验证 PDF 交给 storage workflow 入库。",
        "default": true
      },
      "root_dir": {
        "type": "string",
        "description": "storage 根目录。留空则使用 AstrBot data/plugin_data/<plugin_name> 目录，不使用插件源码目录。",
        "default": ""
      },
      "database_path": {
        "type": "string",
        "description": "SQLite 数据库路径。留空则使用 storage 根目录下的 paperos.sqlite3。",
        "default": ""
      },
      "object_dir": {
        "type": "string",
        "description": "对象文件目录。留空则使用 storage 根目录下的 objects。",
        "default": ""
      },
      "auto_init": {
        "type": "bool",
        "description": "初始化 storage context 时自动创建目录和 SQLite schema。",
        "default": true
      },
      "sqlite_timeout_seconds": {
        "type": "float",
        "description": "SQLite 连接超时时间，秒。",
        "default": 30.0
      },
      "sqlite_busy_timeout_ms": {
        "type": "int",
        "description": "SQLite busy timeout，毫秒。",
        "default": 5000
      },
      "sqlite_journal_mode": {
        "type": "string",
        "description": "SQLite journal mode。",
        "default": "WAL",
        "options": ["WAL", "DELETE", "TRUNCATE", "PERSIST", "MEMORY", "OFF"]
      },
      "sqlite_synchronous": {
        "type": "string",
        "description": "SQLite synchronous 模式。",
        "default": "NORMAL",
        "options": ["OFF", "NORMAL", "FULL", "EXTRA"]
      }
    }
  },
  "search_policy": {
    "type": "object",
    "description": "论文搜索策略",
    "items": {
      "accept_min_score": {
        "type": "float",
        "description": "自动接受 top1 的最低分数",
        "default": 0.70
      },
      "ambiguous_gap_threshold": {
        "type": "float",
        "description": "top1 与 top2 分差低于该值时认为有歧义",
        "default": 0.08
      },
      "identifier_title_min_similarity": {
        "type": "float",
        "description": "LLM 给出 DOI/arXiv/URL 时，抓取到的标题与计划标题的最低相似度；低于该值视为错误 identifier",
        "default": 0.78
      },
      "max_return_candidates": {
        "type": "int",
        "description": "最多返回候选数量",
        "default": 5
      },
      "enable_fulltext_verify": {
        "type": "bool",
        "description": "启用全文候选 URL 验证",
        "default": true
      },
      "max_fulltext_candidates": {
        "type": "int",
        "description": "每篇论文最多验证多少个全文候选 URL",
        "default": 5
      },
      "download_timeout_seconds": {
        "type": "int",
        "description": "PDF 下载验证超时时间，秒",
        "default": 60
      },
      "max_pdf_size_mb": {
        "type": "int",
        "description": "单个 PDF 最大大小，MB",
        "default": 100
      }
    }
  }
}
