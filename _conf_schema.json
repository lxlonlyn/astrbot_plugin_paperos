{
  "general": {
    "type": "object",
    "description": "通用配置",
    "items": {
      "default_provider_id": {
        "type": "string",
        "description": "通用模型 Provider",
        "hint": "用于 QueryAnalyzer 等轻量 LLM 调用。留空则使用当前会话默认 Provider。",
        "default": "",
        "_special": "select_provider"
      },
      "thinking_provider_id": {
        "type": "string",
        "description": "思考模型 Provider",
        "hint": "用于论文理解、方法分析、规划等较重任务。留空则回退到通用 Provider。",
        "default": "",
        "_special": "select_provider"
      },
      "debug": {
        "type": "bool",
        "description": "启用调试日志",
        "default": false
      }
    }
  },
  "query_analyzer": {
    "type": "object",
    "description": "自然语言检索解析",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用 LLM QueryAnalyzer",
        "default": true
      },
      "provider_id": {
        "type": "string",
        "description": "QueryAnalyzer 使用的模型 Provider",
        "hint": "留空则使用 general.default_provider_id；仍为空则使用当前会话 Provider。",
        "default": "",
        "_special": "select_provider"
      },
      "max_repair_rounds": {
        "type": "int",
        "description": "网页搜索/targeted crawler 查不到候选时，允许 LLM 修复 SearchPlan 的轮数",
        "default": 1
      },
      "max_hypotheses": {
        "type": "int",
        "description": "LLM 最多生成多少个检索假设",
        "default": 6
      }
    }
  },
  "web_search": {
    "type": "object",
    "description": "按需网页搜索配置",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用网页搜索",
        "default": true
      },
      "backend": {
        "type": "string",
        "description": "网页搜索后端",
        "default": "duckduckgo_html",
        "options": ["duckduckgo_html"]
      },
      "endpoint": {
        "type": "string",
        "description": "搜索后端 endpoint",
        "default": "https://duckduckgo.com/html/"
      },
      "timeout_seconds": {
        "type": "int",
        "description": "网页搜索请求超时时间，秒",
        "default": 20
      },
      "max_results_per_query": {
        "type": "int",
        "description": "每个 query 最多取多少个网页结果",
        "default": 5
      },
      "max_total_results": {
        "type": "int",
        "description": "一次搜索最多保留多少个网页结果",
        "default": 20
      },
      "user_agent": {
        "type": "string",
        "description": "HTTP User-Agent",
        "default": "Mozilla/5.0 (compatible; PaperOS/0.2; +https://github.com/lxlonlyn/astrbot_plugin_paperos)"
      }
    }
  },
  "crawler": {
    "type": "object",
    "description": "按需 targeted crawler 配置",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用 targeted crawler",
        "default": true
      },
      "timeout_seconds": {
        "type": "int",
        "description": "候选页面请求超时时间，秒",
        "default": 25
      },
      "max_pages": {
        "type": "int",
        "description": "一次搜索最多爬取多少个候选页面",
        "default": 20
      },
      "max_html_bytes": {
        "type": "int",
        "description": "单个 HTML 页面最大读取字节数",
        "default": 2097152
      },
      "max_pdf_links_per_page": {
        "type": "int",
        "description": "单个页面最多抽取多少个 PDF 链接",
        "default": 8
      },
      "academic_api_fallback": {
        "type": "bool",
        "description": "启用旧学术 API fallback。默认关闭；未来只建议用于 metadata enrichment，不建议阻塞 PDF 获取。",
        "default": false
      }
    }
  },
  "core_api": {
    "type": "object",
    "description": "Legacy CORE API 配置。默认不参与搜索主链路，仅保留兼容。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用旧 CORE provider fallback（不推荐）",
        "default": false
      },
      "api_key": {
        "type": "string",
        "description": "CORE API Key",
        "default": "",
        "obscure": true
      },
      "base_url": {
        "type": "string",
        "description": "CORE API Base URL",
        "default": "https://api.core.ac.uk/v3"
      },
      "timeout_seconds": {
        "type": "int",
        "description": "请求超时时间，秒",
        "default": 25
      },
      "default_limit": {
        "type": "int",
        "description": "默认候选数量",
        "default": 10
      },
      "topic_candidate_limit": {
        "type": "int",
        "description": "话题发现候选数量",
        "default": 20
      },
      "sort": {
        "type": "string",
        "description": "CORE 排序方式",
        "default": "relevance",
        "options": ["relevance", "recency"]
      }
    }
  },
  "search_policy": {
    "type": "object",
    "description": "论文搜索策略",
    "items": {
      "accept_min_score": {
        "type": "float",
        "description": "自动接受 top1 的最低分数",
        "default": 0.70
      },
      "ambiguous_gap_threshold": {
        "type": "float",
        "description": "top1 与 top2 分差低于该值时认为有歧义",
        "default": 0.08
      },
      "max_return_candidates": {
        "type": "int",
        "description": "最多返回候选数量",
        "default": 5
      },
      "enable_fulltext_verify": {
        "type": "bool",
        "description": "启用全文候选 URL 验证",
        "default": true
      },
      "max_fulltext_candidates": {
        "type": "int",
        "description": "每篇论文最多验证多少个全文候选 URL",
        "default": 5
      },
      "download_timeout_seconds": {
        "type": "int",
        "description": "PDF 下载验证超时时间，秒",
        "default": 60
      },
      "max_pdf_size_mb": {
        "type": "int",
        "description": "单个 PDF 最大大小，MB",
        "default": 100
      }
    }
  }
}
